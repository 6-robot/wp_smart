# ESP32-S3 UART1 communication adapter, WCH 1a86:55d4.
# Installed as 99-smart-base.rules by scripts/create_udev_rule.sh.
# No serial restriction: connect only one matching adapter to use this alias.
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", MODE="0660", GROUP="dialout", SYMLINK+="smart_base"
